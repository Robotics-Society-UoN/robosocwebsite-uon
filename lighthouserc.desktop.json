{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": ["http://localhost/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1 }]
      }
    }
  }
}
